# Telegram bot token from @BotFather. Keep it secret.
TELEGRAM_BOT_TOKEN=put_your_bot_token_here

# Current Telegram group ID where RSVP notifications and management commands live.
TELEGRAM_CHAT_ID=put_your_group_chat_id_here

# Optional: another notification recipient, if you still use one.
TELEGRAM_CHAT_ID_2=

# Numeric Telegram user IDs allowed to view/delete guest records (comma-separated).
TELEGRAM_ADMIN_USER_IDS=first_user_id,second_user_id

# Secret for authenticating Telegram webhook requests. Use letters, numbers, _ and - only.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# PostgreSQL connection URL from your database provider (for example Supabase).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional. Render's RENDER_EXTERNAL_URL is used automatically if this is omitted.
TELEGRAM_WEBHOOK_URL=
